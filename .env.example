# The site is a static export (GitHub Pages), so the contact and home value forms
# post straight from the browser to the forms Worker (forms-worker/), which emails
# each lead to Billy. Locally, run the Worker with `npm run dev` in forms-worker/
# and set this to http://localhost:8787. For the live site, set the deployed
# Worker's URL as the repo variable FORM_ENDPOINT
# (Settings → Secrets and variables → Actions → Variables).
#
# Without it: `npm run dev` logs leads to the browser console and shows success;
# a production build asks visitors to call or text instead.
NEXT_PUBLIC_FORM_ENDPOINT=

# Set by the deploy workflow ("/<repo-name>"). Leave empty locally and once a
# custom domain points at the site.
PAGES_BASE_PATH=
