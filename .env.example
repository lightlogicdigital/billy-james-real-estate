# Lead emails (contact + home value forms) are sent with Resend when both of
# these are set. Without them, submissions are logged to the server console and
# visitors still see a success message.
RESEND_API_KEY=
LEAD_TO_EMAIL=

# Optional. Must be an address on a domain verified in Resend.
# Defaults to Resend's onboarding sender, which only delivers to your own account.
LEAD_FROM_EMAIL="Billy James Website <leads@billyjamesrealestate.com>"
